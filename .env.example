# Скопируй в .env и заполни

# Обязательно — сгенерируй свой:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# База данных (менять только если postgres на другом хосте)
DATABASE_URL=postgresql+psycopg://hm:hm@home-media-postgres:5432/home_media

# Docker
PLUGIN_NETWORK=home-media-net
DATA_DIR=/app/data
